# Copy to .env and fill in, then run `npm run build`.
# Values are baked into dist/ at build time — rebuild after changing them.

# Providers are tried in this order. When one is over its rate limit, erroring or
# unreachable, the next one rates the post. Available: gemini, groq, anthropic, openai.
LLM_PROVIDERS=gemini,groq

# Every provider accepts:
#   <ID>_API_KEY   required
#   <ID>_MODEL     model id (defaults shown below)
#   <ID>_EFFORT    optional reasoning effort, e.g. low (Gemini thinkingLevel /
#                  OpenAI-style reasoning_effort / Claude effort)
#   <ID>_RPM       optional client-side cap on requests per minute
#   <ID>_RPD       optional client-side cap on requests per day (resets midnight Pacific)
#   <ID>_BASE_URL  optional API base URL override

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EFFORT=low
GEMINI_RPM=15
GEMINI_RPD=500

# Groq (OpenAI-compatible)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_EFFORT=low

# Anthropic Claude
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=low

# Any OpenAI-compatible endpoint (OpenAI, OpenRouter, Ollama, LM Studio, ...)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
