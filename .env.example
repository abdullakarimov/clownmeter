# Copy to .env and fill in, then run `npm run build`.
# Values are baked into dist/ at build time — rebuild after changing them.

# "anthropic" (Claude API) or "openai" (any OpenAI-compatible chat completions
# endpoint: OpenAI, OpenRouter, Groq, Together, Ollama, LM Studio, ...)
LLM_PROVIDER=anthropic

LLM_API_KEY=

# e.g. claude-opus-5-5, claude-sonnet-5-5, claude-haiku-4-5, gpt-5-mini, ...
LLM_MODEL=claude-opus-5-5

# Optional. Defaults: https://api.anthropic.com (anthropic), https://api.openai.com/v1 (openai).
# Examples: https://openrouter.ai/api/v1, http://localhost:11434/v1 (Ollama)
LLM_BASE_URL=

# Optional, Claude models that support it: low | medium | high. Low keeps per-post latency and cost down.
LLM_EFFORT=low
